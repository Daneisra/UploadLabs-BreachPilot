{
	"name": "BreachPilot",
	"namespace": "Daneisra",
	"version_number": "0.5.1",
	"description": "Hacking quality of life. Sets each Breach node to its most profitable threat level for the chosen objective, elite levels included, from the attacks it observes. A read-only Smart Hacking Advisor (Ctrl+Alt+F8) suggests the best wiring, purchases and things to try. Regulation off by default.",
	"website_url": "https://github.com/Daneisra/UploadLabs-BreachPilot",
	"dependencies": [],
	"extra": {
		"godot": {
			"authors": ["Daneisra"],
			"compatible_game_version": ["3.0.12"],
			"compatible_mod_loader_version": ["7.0.1"],
			"config_schema": {
				"type": "object",
				"properties": {
					"threat_observer_enabled": {
						"type": "boolean",
						"default": true
					},
					"log_level": {
						"type": "string",
						"enum": ["debug", "info", "warning"],
						"default": "info"
					},
					"starvation_ratio": {
						"type": "number",
						"minimum": 0.05,
						"maximum": 1.0,
						"default": 0.25
					},
					"api_dump": {
						"type": "boolean",
						"default": false
					},
					"debug_toggle_hotkey": {
						"type": "boolean",
						"default": false
					},
					"regulation_mode": {
						"type": "string",
						"enum": ["off", "dry_run", "active"],
						"default": "off"
					},
					"regulation_profile": {
						"type": "string",
						"enum": ["conservative", "balanced", "aggressive"],
						"default": "balanced"
					},
					"max_allowed_level": {
						"type": "integer",
						"minimum": -1,
						"default": 0
					},
					"gap_probe": {
						"type": "boolean",
						"default": false
					},
					"min_level": {
						"type": "integer",
						"minimum": 0,
						"default": 0
					}
				}
			},
			"description_rich": "",
			"image": null,
			"incompatibilities": ["Daneisra-SmartAutomation"],
			"load_before": [],
			"optional_dependencies": [],
			"tags": ["qol"]
		}
	}
}
